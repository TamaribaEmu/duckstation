# Renderer options.
option(ENABLE_OPENGL "Build with OpenGL renderer" ON)
option(ENABLE_VULKAN "Build with Vulkan renderer" ON)
option(BUILD_NOGUI_FRONTEND "Build the NoGUI frontend" OFF)
option(BUILD_QT_FRONTEND "Build the Qt frontend" ON)
option(BUILD_REGTEST "Build regression test runner" OFF)
option(BUILD_TESTS "Build unit tests" OFF)
# The libretro core (src/duckstation-libretro): no GUI, no window, Vulkan only, and none of the desktop libraries.
option(BUILD_LIBRETRO_CORE "Build the libretro core instead of the desktop frontends" OFF)

if(LINUX OR BSD)
  option(ENABLE_X11 "Support X11 window system" ON)
  option(ENABLE_WAYLAND "Support Wayland window system" ON)
  option(ALLOW_INSTALL "Allow installation to CMAKE_INSTALL_PREFIX" OFF)
endif()
if(BUILD_LIBRETRO_CORE)
  set(BUILD_QT_FRONTEND OFF CACHE BOOL "" FORCE)
  set(BUILD_NOGUI_FRONTEND OFF CACHE BOOL "" FORCE)
  set(BUILD_REGTEST OFF CACHE BOOL "" FORCE)
  set(ENABLE_OPENGL OFF CACHE BOOL "" FORCE)
  set(ENABLE_VULKAN ON CACHE BOOL "" FORCE)
  set(ENABLE_X11 OFF CACHE BOOL "" FORCE)
  set(ENABLE_WAYLAND OFF CACHE BOOL "" FORCE)
  add_compile_definitions(DUCKSTATION_LIBRETRO=1)
  # One shared library that shows only the libretro API: everything else is hidden, so that its own symbols
  # (among them Vulkan entry points kept as variables named like the loader's functions) bind inside it.
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
  set(CMAKE_C_VISIBILITY_PRESET hidden)
  set(CMAKE_CXX_VISIBILITY_PRESET hidden)
  set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
endif()
if(APPLE)
  option(SKIP_POSTPROCESS_BUNDLE "Disable bundle post-processing, including Qt additions" OFF)
endif()
